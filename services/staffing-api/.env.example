# -----------------------------------------------------------------------------
# DATA MODE SWITCH — set one, restart uvicorn after any change
# -----------------------------------------------------------------------------
# azure      = dbo.rv2_* (from PT + ZingHR refresh)
# azure_raw  = project_track_proposals_table + zinghr_employee_master each cache
# demo       = synthetic (tests only)
RV_DATA_MODE=azure

# Advanced override when RV_DATA_MODE is unset: azure | azure_raw | demo
# RV_DATA_SOURCE=azure

# Staffing workflow tables: azure (dbo.rv_staffing_*) or memory (dev/tests only).
# When RV_DATA_MODE=demo, persistence is forced to memory.
STAFFING_PERSISTENCE=azure

# -----------------------------------------------------------------------------
# Azure SQL — set AZURE_SQL_CONNECTION_STRING only (recommended).
# Four-part AZURE_SQL_* below are optional fallback if the connection string is empty.
# -----------------------------------------------------------------------------
AZURE_SQL_CONNECTION_STRING=
# AZURE_SQL_SERVER=
# AZURE_SQL_DATABASE=
# AZURE_SQL_USERNAME=
# AZURE_SQL_PASSWORD=
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no
AZURE_SQL_MAX_ROWS=0

RV_VERSION_CHECK_SECONDS=5
RV_CACHE_SECONDS=60
RV_CAPACITY_HOURS=176
RV_SKILLS_CACHE_SECONDS=300

API_HOST=127.0.0.1
API_PORT=8010
CORS_ORIGINS=http://localhost:5174,http://localhost:5175,http://127.0.0.1:5174,http://127.0.0.1:5175
DEV_LAUNCH_TOKEN=dev-simulator-token
EMPLOYEE_BLOCK_MAX=3
INTERVIEW_EXPIRY_DAYS=7
TRAINING_RATIO=0.85
REFRESH_DEBOUNCE_SECONDS=30
SKILL_LEVEL_ORDER=Foundational,Applied,Advanced,Expert

# MyNextHire staffing email (draft only until outbound mail is wired)
MNH_HR_TO=hr-staffing@mynexthire.example
MNH_BU_LEAD_CC=bu-lead@example.com